#!/usr/bin/env sh
publisher=$1
extname=$2
shift 2

extdir="$HOME/.dotfiles/.data/vscode-extensions/${extname#vscode-}"
datadir="$HOME/.dotfiles/.data/vscode-datadirs/${extname#vscode-}"
if [ ! -d "$extdir" ]; then
	notify-send 'Failed to launch. Install ecosystem extensions with the script.'
fi
exec code --user-data-dir "$datadir" --extensions-dir "$extdir" "$@"
