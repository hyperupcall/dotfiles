{
	//
	// WINDOW
	"window.customMenuBarAltFocus": false,
	"window.newWindowDimensions": "maximized",
	"window.restoreWindows": "all",
	"window.title": "${folderName} ${activeEditorLong}${separator}${remoteName}",
	"window.titleBarStyle": "custom",

	//
	// EDITOR
	"editor.acceptSuggestionOnCommitCharacter": false,
	"editor.acceptSuggestionOnEnter": "off",
	"editor.bracketPairColorization.enabled": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports": "never",
		"source.fixAll": "explicit"
	},
	"editor.codeLens": true,
	"editor.detectIndentation": true,
	"editor.find.addExtraSpaceOnTop": false,
	"editor.find.autoFindInSelection": "multiline",
	// "editor.fontFamily": "'Droid Sans Mono', 'Fira Sans Mono', 'monospace'",
	"editor.fontLigatures": true,
	"editor.fontSize": 16,
	"editor.formatOnSave": true,
	"editor.formatOnPaste": false,
	"editor.formatOnType": false,
	"editor.inlineSuggest.enabled": true,
	"editor.linkedEditing": true,
	"editor.maxTokenizationLineLength": 5000,
	"editor.minimap.maxColumn": 25,
	"editor.minimap.renderCharacters": false,
	"editor.minimap.showSlider": "always",
	"editor.minimap.side": "left",
	"editor.renderWhitespace": "all",
	"editor.suggestSelection": "recentlyUsedByPrefix",
	"editor.suggest.snippetsPreventQuickSuggestions": false,
	"editor.tabSize": 3,
	"editor.unfoldOnClickAfterEndOfLine": true,
	"editor.wordWrap": "on",
	"editor.wordWrapColumn": 100,
	"editor.wrappingIndent": "indent",

	//
	// TERMINAL
	"terminal.external.linuxExec": "x-terminal-emulator",
	"terminal.integrated.defaultProfile.linux": "bash",
	"terminal.explorerKind": "external",
	"terminal.integrated.altClickMovesCursor": false,
	"terminal.integrated.commandsToSkipShell": [
		"-workbench.action.terminal.focusFind",
		"-workbench.action.quickOpen",
		"language-julia.interrupt"
	],
	"terminal.integrated.allowChords": false,
	"terminal.integrated.copyOnSelection": false,
	"terminal.integrated.environmentChangesIndicator": "on",
	"terminal.integrated.inheritEnv": false,
	"terminal.integrated.showExitAlert": false,
	"files.autoSaveDelay": 5000,
	"files.associations": {
		"*.hbs": "html",
		"*.rasi": "css",
		"Vagrantfile": "ruby",
		"**/i3/config": "i3",
		"Xresources": "xdefaults",
		"*.html": "html",
		"*.bbmodel": "json",
		"*.jscript": "java",
		"*.sublime-snippet": "xml",
		"*.ejs": "html"
	},
	"files.exclude": {
		"**/.git": false,
		"**/.hg": false,
		"**/.fossil": false,
		"**/.svn": false,
		"**/CVS": false
	},
	"files.insertFinalNewline": true,
	"files.participants.timeout": 2000,
	"files.simpleDialog.enable": true,
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/web_modules/**": true,
		"**/jspm_modules/**": true,
		"**/bower_components/**": true,
		"**/linux/**": true,
		"**/rootfs/**": true
	},

	//
	// SEARCH
	"search.exclude": {
		"**/.git": true,
		"**/.hg": true,
		"**/.fossil": true,
		"**/.svn": true,
		"**/package-lock.json": true,
		"**/pnpm-lock.yaml": true,
		"**/yarn.lock": true,
		"**/.hidden/": true,
		"**/.hooks/.hookah": true,
		"**/bake": true
	},
	"search.searchOnTypeDebouncePeriod": 100,
	"search.showLineNumbers": true,
	"search.smartCase": true,

	//
	// WORKBENCH
	"workbench.commandPalette.history": 100,
	"workbench.editor.closeOnFileDelete": true,
	"workbench.editor.empty.hint": "hidden",
	"workbench.editor.highlightModifiedTabs": true,
	"workbench.editor.languageDetection": false,
	"workbench.editor.tabActionCloseVisibility": false,
	"workbench.enableExperiments": false,
	"workbench.quickOpen.closeOnFocusLost": false,
	"workbench.startupEditor": "none",
	"workbench.tips.enabled": false,
	"workbench.tree.indent": 12,

	//
	// EXPLORER
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"explorer.incrementalNaming": "smart",

	//
	// CORE MISC
	"security.workspace.trust.enabled": false,
	"security.workspace.trust.untrustedFiles": "open",
	"update.mode": "manual",

	//
	// PRETTIER
	"prettier.requireConfig": false,
	"prettier.semi": false,
	"prettier.singleQuote": true,
	"prettier.tabWidth": 3,
	"prettier.useTabs": true,

	//
	// JAVASCRIPT
	"[javascript][javascriptreact]": {
		"editor.codeActionsOnSave": {
			"source.organizeImports": "never",
			"source.fixAll": "never",
			"source.fixAll.eslint": "always"
		},
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"javascript.autoClosingTags": true,
	"javascript.format.indentSwitchCase": false,
	"javascript.format.semicolons": "remove",
	"javascript.referencesCodeLens.enabled": true,
	"javascript.referencesCodeLens.showOnAllFunctions": true,
	"javascript.suggest.autoImports": true,
	"javascript.suggest.completeFunctionCalls": true,
	"javascript.updateImportsOnFileMove.enabled": "always",

	//
	// TYPESCRIPT
	"[typescript][typescriptreact]": {
		"editor.codeActionsOnSave": {
			"source.fixAll": "never",
			"source.fixAll.eslint": "always"
		},
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"typescript.autoClosingTags": true,
	"typescript.format.indentSwitchCase": false,
	"typescript.format.semicolons": "remove",
	"typescript.referencesCodeLens.enabled": true,
	"typescript.referencesCodeLens.showOnAllFunctions": true,
	"typescript.suggest.autoImports": true,
	"typescript.suggest.completeFunctionCalls": true,
	"typescript.updateImportsOnFileMove.enabled": "always",

	"typescript.implementationsCodeLens.enabled": true,
	"typescript.inlayHints.enumMemberValues.enabled": false,
	"typescript.inlayHints.functionLikeReturnTypes.enabled": false,
	"typescript.inlayHints.parameterNames.enabled": "none",
	"typescript.inlayHints.parameterNames.suppressWhenArgumentMatchesName": false,
	"typescript.inlayHints.parameterTypes.enabled": false,
	"typescript.inlayHints.propertyDeclarationTypes.enabled": false,
	"typescript.inlayHints.variableTypes.enabled": false,
	"typescript.inlayHints.variableTypes.suppressWhenTypeMatchesName": false,

	//
	// DENO
	"deno.path": "~/.local/share/mise/installs/deno/2.3.1/bin/deno",

	//
	// JSON
	"[json][jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true,
		"editor.insertSpaces": true,
		"editor.tabSize": 3,
		"editor.defaultFoldingRangeProvider": "esbenp.prettier-vscode"
	},
	"[jsonnet]": {
		"editor.defaultFormatter": "Sebbia.jsonnetng",
		"editor.formatOnSave": true,
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.defaultFoldingRangeProvider": "esbenp.prettier-vscode"
	},

	//
	// TOML
	"[toml]": {
		"editor.defaultFormatter": "tamasfe.even-better-toml",
		"editor.insertSpaces": false,
		"editor.tabSize": 3
	},
	"evenBetterToml.schema.associations": {
		"basalt.toml": "https://raw.githubusercontent.com/hyperupcall/foxxo/main/src/schemas/basalt.schema.json"
	},

	//
	// YAML
	"[yaml]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},
	"yaml.format.printWidth": 100,
	"yaml.format.singleQuote": true,

	//
	// HTML
	"[html]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"html.autoClosingTags": true,
	"html.format.enable": false,
	"html.format.wrapLineLength": 0,

	//
	// HTML MISC
	"[vue]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[handlebars]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	//
	// CSS
	"[css]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"css.validate": false,
	"[less]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"less.validate": false,
	"[scss]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"scss.validate": false,
	"[graphql]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	//
	// MARKDOWN
	"[markdown]": {
		"editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
		"editor.formatOnSave": true,
		"editor.wordWrap": "on",
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},
	"[markdown-math]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true,
		"editor.wordWrap": "on",
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},
	"[juliamarkdown]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true,
		"editor.wordWrap": "on",
		"editor.insertSpaces": true,
		"editor.tabSize": 2
	},
	"markdownlint.run": "onSave",
	"markdownlint.lintWorkspaceGlobs": [
		// default
		"**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}",
		"!**/bower_components",
		"!**/node_modules",
		"!**/vendor",
		"!**/.git",
		// custom
		"**/*LICENSE*",
		"**/*license*"
	],
	"markdownlint.focusMode": true,
	"markdownlint.config": {
		"first-heading-h1": false,
		"first-line-heading": false,
		"no-bare-urls": false,
		"no-duplicate-header": false,
		"no-hard-tabs": false,
		"no-inline-html": false,
		"ol-prefix": false
	},
	"markdown.preview.doubleClickToSwitchToEditor": false,

	//
	// PYTHON
	"[python]": {
		"editor.defaultFormatter": "charliermarsh.ruff",
		"editor.codeActionsOnSave": {
			"source.fixAll": "never"
		},
		"editor.insertSpaces": true,
		"editor.formatOnSave": false,
		"editor.tabSize": 4
	},
	"python.globalModuleInstallation": false,
	"python.venvPath": "~/.dotfiles/.home/xdg_cache_dir/pypoetry/virtualenvs",
	"python.languageServer": "Pylance",
	"python.analysis.typeCheckingMode": "strict",

	//
	// BASH
	"shellcheck.run": "onType",
	"shellcheck.customArgs": ["--external-sources"],
	"[shellscript]": {
		"editor.codeActionsOnSave": {
			"source.fixAll": "never"
		},
		"editor.insertSpaces": false,
		"editor.formatOnSave": false,
		"editor.tabSize": 3
	},

	//
	// FISH
	"[fish]": {
		"editor.defaultFormatter": "bmalehorn.vscode-fish",
		"editor.insertSpaces": true,
		"editor.tabSize": 4,
		"editor.formatOnSave": true
	},

	//
	// GO
	"[go]": {
		"editor.defaultFormatter": "golang.go"
	},
	"go.toolsManagement.autoUpdate": true,

	//
	// JAVA
	"[java]": {
		"editor.defaultFormatter": "redhat.java"
	},
	"java.project.importOnFirstTimeStartup": "automatic",

	//
	// JULIA
	"julia.symbolCacheDownload": true,

	//
	// PERL
	"[perl]": {
		"editor.defaultFormatter": "bscan.perlnavigator"
	},

	//
	// DOCKER
	"[dockerfile]": {
		"editor.defaultFormatter": "ms-azuretools.vscode-docker"
	},
	"vsdocker.imageUser": "docker.io/hyperupcall",

	//
	// RUST
	"[rust]": {
		"editor.formatOnSave": true,
		"editor.defaultFormatter": "rust-lang.rust-analyzer"
	},
	"rust-analyzer.lens.enable": false,
	"rust-analyzer.inlayHints.typeHints.enable": false,

	//
	// LATEX
	"[latex]": {
		"editor.defaultFormatter": "James-Yu.latex-workshop"
	},
	"latex-workshop.formatting.latex": "latexindent",
	"latex-utilities.message.update.show": false,

	//
	// EMMET
	"emmet.excludeLanguages": [],
	"emmet.includeLanguages": {
		"vue-html": "html",
		"javascript": "javascriptreact"
	},
	"emmet.triggerExpansionOnTab": true,

	//
	// GIT, GITHUB, GITLENS
	"git.alwaysShowStagedChangesResourceGroup": true,
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.enableCommitSigning": true,
	"git.openRepositoryInParentFolders": "never",
	"github.copilot.editor.enable": true,
	"gitlens.advanced.blame.customArguments": ["-M", "-C"],
	"gitlens.advanced.maxListItems": 300,
	"gitlens.advanced.maxSearchItems": 300,
	"gitlens.codeLens.includeSingleLineSymbols": true,
	"gitlens.codeLens.enabled": false,

	// VSCORD
	"vscord.app.name": "Visual Studio Code",
	"vscord.app.privacyMode.enable": false,
	"vscord.status.problems.enabled": false,
	"vscord.behaviour.suppressNotifications": true,

	//
	// UNSORTED EDITOR
	"diffEditor.ignoreTrimWhitespace": false,
	"merge-conflict.autoNavigateNextConflict.enabled": true,
	"merge-conflict.diffViewPosition": "Beside",
	"symbols.hidesExplorerArrows": false,

	//
	// UNSORTED PLUGIN
	"comment-divider.length": 60,
	"debug.node.autoAttach": "on",
	"screencastMode.onlyKeyboardShortcuts": true,
	"sqltools.useNodeRuntime": true,
	"cmake.configureOnOpen": true,
	"cmake.showOptionsMovedNotification": false,
	"vim.enableNeovim": true,
	"esbonio.server.enabled": false,
	"zenMode.centerLayout": true,
	"npm.keybindingsChangedWarningShown": true,
	"liveServer.settings.showOnStatusbar": false,
	"vsicons.associations.files": [
		{
			"icon": "shell",
			"extensions": ["bake"],
			"filename": true,
			"format": "svg"
		}
	],
	"cSpell.diagnosticLevel": "Hint",
	"cSpell.dictionaryDefinitions": [
		{
			"name": "Personal",
			"path": "~/.dotfiles/config/dictionary-hyperupcall.txt",
			"addWords": true
		}
	],
	"cSpell.dictionaries": ["Tech", "Personal"],
	"svelte.enable-ts-plugin": true,

	//
	// C/C++
	"[c][cpp][cuda-cpp]": {
		"editor.defaultFormatter": "ms-vscode.cpptools",
		"editor.insertSpaces": false,
		"editor.tabSize": 3,
		"editor.codeActionsOnSave": {
			"source.fixAll": "explicit",
			"source.organizeImports": "explicit"
		},
		"editor.formatOnSave": true
	},
	"C_Cpp.intelliSenseEngine": "disabled",
	"C_Cpp.default.cppStandard": "c++20",
	"C_Cpp.default.cStandard": "c17",
	"C_Cpp.inlayHints.autoDeclarationTypes.enabled": true,
	"C_Cpp.inlayHints.parameterNames.enabled": true,
	"C_Cpp.inlayHints.referenceOperator.enabled": true,
	"C_Cpp.codeAnalysis.runAutomatically": false,
	"C_Cpp.codeAnalysis.clangTidy.enabled": true,
	"C_Cpp.codeAnalysis.clangTidy.fallbackConfig": "{ Checks: 'bugprone-*,cert-*,clang-analyzer-*,concurrency-*,cppcoreguidelines-*,google-*,hicpp-*,misc-*,modernize-*,performance-*,portability-*,readability-*,-bugprone-easily-swappable-parameters,-clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,-clang-analyzer-deadcode.DeadStores,-concurrency-mt-unsafe,-cppcoreguidelines-avoid-c-arrays,-cppcoreguidelines-avoid-magic-numbers,-cppcoreguidelines-avoid-non-const-global-variables,-cppcoreguidelines-macro-usage,-cppcoreguidelines-owning-memory,-cppcoreguidelines-pro-bounds-pointer-arithmetic,-cppcoreguidelines-pro-bounds-array-to-pointer-decay,-google-readability-braces-around-statements,-google-readability-casting,-google-readability-todo,-google-runtime-references,-modernize-avoid-c-arrays,-modernize-use-trailing-return-type,-readability-braces-around-statements,-readability-convert-member-functions-to-static,-readability-else-after-return,-readability-identifier-length,-readability-isolate-declaration,-readability-magic-numbers,-misc-unused-parameters'}",
	"C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: LLVM, UseTab: ForIndentation, IndentWidth: 3, TabWidth: 3, AlignEscapedNewlines: Left, AllowShortFunctionsOnASingleLine: Empty, AlwaysBreakTemplateDeclarations: Yes, ColumnLimit: 120 }",
	"C_Cpp.clang_format_sortIncludes": true,
	"c-cpp-flylint.cppcheck.enable": false,
	"c-cpp-flylint.flawfinder.enable": true,
	"c-cpp-flylint.lizard.enable": true,

	//
	// DISABLE TELEMETRY, NOTIFICATIONS & WHAT'S NEW
	"telemetry.telemetryLevel": "off",
	"clangd.checkUpdates": false,
	"redhat.telemetry.enabled": false,
	"julia.enableTelemetry": false,
	"terraform.telemetry.enabled": false,
	"sonarlint.disableTelemetry": true,
	"vsicons.dontShowNewVersionMessage": true,
	"kite.showWelcomeNotificationOnStartup": false,
	"gitlens.showWelcomeOnInstall": false,
	"liveServer.settings.donotShowInfoMsg": true,
	"java.help.firstView": "none",
	"java.help.showReleaseNotes": false,
	"gitlens.showWhatsNewAfterUpgrades": false,
	"update.showReleaseNotes": false,
	"material-icon-theme.showWelcomeMessage": false,
	"docker-explorer.enableTelemetry": false,
	"code-runner.enableAppInsights": false,
	"rpcServer.showStartupMessage": false,
	"shellcheck.disableVersionCheck": true,
	"extensions.ignoreRecommendations": true,
	"workbench.welcomePage.walkthroughs.openOnInstall": false,
	"Lua.telemetry.enable": false,

	// OTHER
	"workbench.colorTheme": "Solarized Light",
	"editor.cursorBlinking": "smooth",
	"editor.fontFamily": "'Hack', monospace",
}
