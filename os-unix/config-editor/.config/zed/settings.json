{
	"show_edit_predictions": false,
	"hard_tabs": true,
	"tab_size": 3,
	"languages": {
		"YAML": {
			"hard_tabs": false,
			"tab_size": 2
		},
		"C": {
			"format_on_save": "on"
		},
		"C++": {
			"format_on_save": "on"
		}
	},
	"features": {
		"edit_prediction_provider": "zed"
	},
	"terminal": {
		// https://github.com/zed-industries/zed/issues/14543#issuecomment-2260593838
		// https://github.com/zed-industries/zed/issues/21387
		"option_as_meta": true
	},
	"soft_wrap": "editor_width",
	"agent": {
		"play_sound_when_agent_done": true,
  "default_model": {
			"provider": "google",
			"model": "gemini-2.5-flash"
		},
		"version": "2"
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"buffer_font_family": "Hack",
	"ui_font_size": 16,
	"buffer_font_size": 16,
	"theme": {
		"mode": "system",
		"light": "Ayu Light",
		"dark": "One Dark"
	}
}
