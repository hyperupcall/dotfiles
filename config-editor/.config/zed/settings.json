          "openrouter/z-ai/glm-5.3",
          "opencode/minimax-m3.1-flash-free",
          "openrouter/openai/gpt-6.1-terra"
        ]
      },
      "type": "registry"
    },
    "antigravity-acp": {
      "default_config_options": {
        "model": "gemini-3.8-flash"
      },
      "type": "registry"
    },
    "devin": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "high",
        "model": "opus",
        "mode": "auto"
      },
      "favorite_config_option_values": {
        "model": [
          "opus",
          "sonnet",
          "default"
        ]
      },
      "type": "registry"
    },
    "Cursor (Custom)": {
      "default_config_options": {
        "model": "claude-opus-5-5[context=300k,effort=medium,fast=false]"
      },
      "favorite_config_option_values": {
        "model": [
          "claude-sonnet-5-5[context=300k,reasoning_effort=high]",
          "claude-opus-5-5[context=300k,effort=medium,fast=false]",
          "gemini-4-argon[reasoning_effort=medium]",
          "gemini-3.8-flash[reasoning_effort=high]"
        ]
      },
      "type": "custom",
      "command": "~~~/.local/bin/agent",
      "args": ["--force", "acp"],
      "env": {}
    },
    "github-copilot-cli": {
      "default_config_options": {
        "reasoning_effort": "xhigh",
        "model": "gpt-6.1-terra",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#autopilot"
      },
      "favorite_config_option_values": {
        "model": ["claude-sonnet-5.5", "gpt-6.1-terra"]
      },
      "type": "registry"
    },
    "cursor": {
      "favorite_config_option_values": {
        "context": ["256k"],
        "model": [
          "default",
          "composer-2.5",
          "claude-sonnet-5-5",
          "claude-opus-5-5",
          "grok-4.7",
          "gemini-4-argon"
        ]
      },
      "default_config_options": {
        "mode": "agent",
        "context": "256k",
        "model": "claude-sonnet-5-5"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6.1-sol",
        "reasoning_effort": "high",
        "collaboration_mode": "default",
        "mode": "agent"
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "new_window",
  "context_servers": {},
  "edit_predictions": {
    "provider": "zed"
  },
  "project_panel": {
    "git_status": true,
    "file_icons": true,
    "hide_root": true,
    "hide_gitignore": false,
    "hide_hidden": false
  },
  "file_types": {
    "HTML": ["**/*.ejs"],
    "JSONC": ["**/*.code-workspaces"],
    "YAML": ["**/.clang-format"]
  },
  "show_edit_predictions": false,
  "hard_tabs": true,
  "tab_size": 3,
  "prettier": {
    "allowed": true,
    "singleQuote": true,
    "semi": false
  },
  "languages": {
    "YAML": {
      "formatter": "language_server",
      "format_on_save": "on",
      "hard_tabs": false,
      "tab_size": 2
    },
    "C": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 3
    },
    "C++": {
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "TOML": {
      "formatter": "language_server"
    },
    "Python": {
      "format_on_save": "off",
      "hard_tabs": false,
      "tab_size": 4
    }
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "onSave": false
          }
        }
      }
    },
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "format": {
            "enable": false,
            "singleQuote": true,
            "bracketSpacing": true
          },
          "validate": true,
          "hover": true,
          "completion": true,
          "keyOrdering": false
        }
      }
    },
    "ruff": {
      "settings": {
        "enable": true
      }
    },
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd-22"
      }
    }
  },
  "jupyter": {
    "enabled": true
  },
  "terminal": {
    // https://github.com/zed-industries/zed/issues/14543#issuecomment-2260593838
    // https://github.com/zed-industries/zed/issues/21387
    "dock": "bottom",
    "option_as_meta": true,
    "detect_venv": {
      "on": {
        "conda_manager": "mamba"
      }
    }
  },
  "soft_wrap": "editor_width",
