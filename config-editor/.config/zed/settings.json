 "cli_default_open_behavior": "new_window",
	"context_servers": {
		},
	"edit_predictions": {
		"provider": "zed",
	},
	"project_panel": {
		"git_status": true,
		"file_icons": true,
		"hide_root": true,
		"hide_gitignore": false,
		"hide_hidden": false,
	},
	"file_types": {
		"HTML": ["**/*.ejs"],
		"JSONC": ["**/*.code-workspaces"],
		"YAML": ["**/.clang-format"],
	},
	"show_edit_predictions": false,
	"hard_tabs": true,
	"tab_size": 3,
	"prettier": {
		"allowed": true,
		"singleQuote": true,
		"semi": false,
	},
	"languages": {
		"YAML": {
			"formatter": "language_server",
			"format_on_save": "on",
			"hard_tabs": false,
			"tab_size": 2,
		},
		"C": {
			"formatter": "language_server",
			"format_on_save": "on",
			"tab_size": 3,
		},
		"C++": {
			"formatter": "language_server",
			"format_on_save": "on",
		},
		"TOML": {
			"formatter": "language_server",
		},
		"Python": {
			"format_on_save": "off",
			"hard_tabs": false,
			"tab_size": 4,
		},
	},
	"lsp": {
		"texlab": {
			"settings": {
				"texlab": {
					"build": {
						"onSave": false,
					},
				},
			},
		},
		"yaml-language-server": {
			"settings": {
				"yaml": {
					"format": {
						"enable": false,
						"singleQuote": true,
						"bracketSpacing": true,
					},
					"validate": true,
					"hover": true,
					"completion": true,
					"keyOrdering": false,
				},
			},
		},
		"ruff": {
			"settings": {
				"enable": true,
			},
		},
		"clangd": {
			"binary": {
				"path": "/usr/bin/clangd-22",
			},
		},
	},
	"jupyter": {
		"enabled": true,
	},
	"terminal": {
		// https://github.com/zed-industries/zed/issues/14543#issuecomment-2260593838
		// https://github.com/zed-industries/zed/issues/21387
		"dock": "bottom",
		"option_as_meta": true,
		"detect_venv": {
			"on": {
				"conda_manager": "mamba",
			},
		},
	},
	"soft_wrap": "editor_width",
	"agent": {
