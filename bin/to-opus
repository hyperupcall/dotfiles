#!/usr/bin/env bash
cleanup() { rm -f "$cover"; }
trap cleanup EXIT

for input; do
    output=${input%.*}.opus
    cover=$(mktemp --suffix=.jpg)

    # 1) Try the embedded cover art (attached_pic stream only)
    ffmpeg -y -i "$input" -map 0:v -map -0:V -c copy -frames:v 1 -update 1 -f image2 "$cover" 2>/dev/null

    # 2) No cover art: grab the frame at 2 seconds, re-encoded as JPEG
    if [ ! -s "$cover" ]; then
        ffmpeg -y -ss 2 -i "$input" -map 0:V:0 -frames:v 1 -update 1 -f image2 "$cover" 2>/dev/null
    fi

    if [ -s "$cover" ]; then
        ffmpeg -i "$input" -f wav - 2>/dev/null | opusenc --picture "$cover" --bitrate 128 - "$output"
    else
        ffmpeg -i "$input" -f wav - 2>/dev/null | opusenc --bitrate 128 - "$output"
    fi

    rm -f "$cover"
    echo "Done: $output"
done
